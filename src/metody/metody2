public class MinMax {

    public static void vypisMin(int[] pole) {
        int min = pole[0];

        for (int i = 1; i < pole.length; i++) {
            if (pole[i] < min) {
                min = pole[i];
            }
        }

        System.out.println("Nejnižší hodnota: " + min);
    }

    public static void vypisMax(int[] pole) {
        int max = pole[0];

        for (int i = 1; i < pole.length; i++) {
            if (pole[i] > max) {
                max = pole[i];
            }
        }

        System.out.println("Nejvyšší hodnota: " + max);
    }

    public static void main(String[] args) {
        int[] cisla = {45, 12, 78, 3, 90, 25};

        vypisMin(cisla);
        vypisMax(cisla);
    }
}
